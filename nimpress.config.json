{
  "title": "Nimpress",
  "logo": "/assets/logo.svg",
  "github": "https://github.com/nimling/nimpress",
  "base": "/nimpress/",
  "contentDir": "docs",
  "paths": {
    "out": "dist/site"
  },
  "site": {
    "title": "Nimpress",
    "url": "https://nimling.github.io",
    "description": "Svelte 5 docs framework that supports it all."
  },
  "brand": {
    "primary": "#CC785C",
    "primaryHover": "#B86A52"
  },
  "repo": {
    "actions": ["edit", "view"]
  },
  "feedback": {
    "endpoint": "https://feedback.example.test/api/feedback",
    "title": "Was this page helpful?",
    "ratings": [
      { "icon": "👍", "name": "This page was helpful", "data": "1", "note": "Thanks for your feedback!" },
      { "icon": "👎", "name": "This page could be improved", "data": "0", "note": "Thanks for your feedback! Help us improve this page by [opening an issue](https://github.com/nimling/nimpress)." }
    ]
  },
  "pageTypes": { "spotlight": "./docs/types/Spotlight.svelte" },
  "seo": { "auto": true, "ai": { "index": true } },
  "icons": "./assets/icons",
  "tags": {
    "icons": { "default": ":lucide-tag:", "setup": ":lucide-settings:", "authoring": ":lucide-pen-line:", "types": ":lucide-layout-template:" },
    "map": { "Setup": "setup", "Authoring": "authoring", "Page types": "types" }
  },
  "defaultFrontmatter": { "feedback": true },
  "announce": {
    "text": "Version 2.4 brings seven new page types and a richer authoring surface.",
    "link": "/changelog",
    "dismiss": true
  },
  "footer": {
    "text": "Built from the docs folder of the nimpress repository on every release.",
    "copyright": "© 2026 Nimling",
    "social": [
      { "icon": "./assets/github.svg", "link": "https://github.com/nimling/nimpress", "name": "nimpress on GitHub" }
    ],
    "navigation": true
  }
}
